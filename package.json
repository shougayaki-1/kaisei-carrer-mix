{
  "name": "kaisei-carrer-mix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "npm run typecheck && npm run check:links && cf build",
    "deploy": "cf deploy",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:areas": "node --test scripts/check-area-map.mjs",
    "check:links": "node scripts/check-park-links.mjs",
    "test:schedule": "node --experimental-strip-types --test tests/schedule-data.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "cf": "latest",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "@types/node": "^22.15.0"
  }
}
