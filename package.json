{
  "name": "kaisei-carrer-mix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "npm run typecheck && npm run check:links && cf build && npm run check:i18n-output",
    "deploy": "cf deploy",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:areas": "node --test scripts/check-area-map.mjs",
    "check:links": "node scripts/check-park-links.mjs",
    "test:schedule": "node --experimental-strip-types --test tests/schedule-data.test.mjs",
    "test:tickets": "node --experimental-strip-types --test tests/ticket-data.test.mjs tests/ticket-artwork.test.mjs",
    "test:services": "node --experimental-strip-types --test tests/services-data.test.mjs",
    "test:events": "node --experimental-strip-types --test tests/events-data.test.mjs",
    "test:i18n": "node --test tests/i18n-data.test.mjs",
    "check:i18n-output": "node scripts/check-i18n-output.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "cf": "latest",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2"
  }
}
