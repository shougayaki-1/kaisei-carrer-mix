{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "park/**/*.ts",
    "vite.config.ts",
    "cloudflare.config.ts"
  ]
}
